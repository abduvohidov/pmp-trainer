# Firebase (вход через Google + сохранение прогресса в облаке).
# Если переменные не заданы — приложение работает в локальном режиме (прогресс в браузере).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Email администраторов через запятую (видят раздел «Админ»: импорт/экспорт/правка вопросов)
VITE_ADMIN_EMAILS=abduvohidov.abdullokh@gmail.com
