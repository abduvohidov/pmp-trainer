rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Каждый пользователь читает и пишет только свой документ прогресса
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Банк вопросов: читают все вошедшие, пишут только администраторы (email из списка)
    match /bank/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email in ['abduvohidov.abdullokh@gmail.com'];
    }
  }
}
